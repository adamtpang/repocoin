# repocoin environment variables. Names only. Never commit real values.
# Copy to .env.local for local development. Without these, only the fixture
# demo at /repocoin-demo/sample-repo works and the webhook returns 503.

# Supabase project URL (Project Settings > API).
SUPABASE_URL=
# Supabase anon key. Used for public page reads; row level security blocks writes.
SUPABASE_ANON_KEY=
# Supabase service role key. Server only. Used by the webhook to write credits.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App id (from the App settings page, after Adam registers the App).
GITHUB_APP_ID=
# GitHub App private key (PEM). Newlines may be written as \n on one line.
GITHUB_APP_PRIVATE_KEY=
# Webhook secret set in the GitHub App settings. Verifies X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
